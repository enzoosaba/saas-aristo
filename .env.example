# Use um caminho absoluto em produção e um volume persistente.
DATABASE_PATH=./data/aristo.sqlite
# Produção Supabase: conexão PostgreSQL do painel Connect (somente servidor).
# Quando definida, DATABASE_URL tem prioridade sobre DATABASE_PATH.
DATABASE_URL=
# Se necessário, certificado CA do painel Supabase, PEM com \n entre linhas.
DATABASE_SSL_CA=
# Fase 3B parte 6: conexão restrita por RLS (role aristo_app), gerada por
# `pnpm db:provision-app-role` — mesmo host/porta/database de DATABASE_URL,
# usuário/senha diferentes. Ainda não usada pelo app em runtime (parte 7).
APP_DATABASE_URL=
# Recuperação de senha: remetente com domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Em produção, defina o domínio HTTPS real, sem barra final.
APP_ORIGIN=http://localhost:3000
# O runtime não precisa de segredo estático: sessões são tokens aleatórios no banco.
PORT=3000
